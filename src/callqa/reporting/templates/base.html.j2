<!DOCTYPE html>
<html dir="rtl" lang="he">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}דוח{% endblock %}</title>
<style>
  /* Same restrained identity as the operator dashboard: near-monochrome slate,
     muted data bars (not colour), status colour only in soft-tint badges,
     indigo reserved for links. System fonts only. Light + dark. */
  :root{
    --page:#f5f6f8; --card:#ffffff; --sunken:#eef0f4; --border:#e7e9ee; --border-2:#dcdfe6;
    --ink:#1a1c22; --ink-2:#565c67; --ink-3:#5f6672;
    --bar:#454b57; --bar-soft:#e4e6ec; --accent:#4338ca;
    --ok:#0e7a5f; --ok-soft:#e7f6f0; --ok-ink:#0b5f4a;
    --warn:#b45309; --warn-soft:#fdf1e3; --warn-ink:#8a4308;
    --bad:#be2a2a; --bad-soft:#fdeceb; --bad-ink:#a11f1f;
    --font:"Segoe UI","Arial Hebrew","Noto Sans Hebrew",system-ui,-apple-system,Arial,sans-serif;
    --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  }
  @media (prefers-color-scheme: dark){ :root{
    --page:#0e0f13; --card:#16181d; --sunken:#1b1e24; --border:#262a32; --border-2:#333843;
    --ink:#eef0f4; --ink-2:#b6bcc7; --ink-3:#8b929e;
    --bar:#aeb5c2; --bar-soft:#262a32; --accent:#a5abfb;
    --ok:#34caa0; --ok-soft:#0f2a22; --ok-ink:#6fe0bf;
    --warn:#e0972f; --warn-soft:#2a1f0d; --warn-ink:#f0b661;
    --bad:#e46060; --bad-soft:#2a1414; --bad-ink:#f0a0a0;
  }}
  * { box-sizing: border-box; }
  body {
    font-family: var(--font); margin: 0; padding: 28px 24px; background: var(--page);
    color: var(--ink); line-height: 1.6; font-size: 14px;
    -webkit-font-smoothing: antialiased;
  }
  .container { max-width: 880px; margin: 0 auto; }
  .card {
    background: var(--card); border: 1px solid var(--border); border-radius: 12px;
    padding: 20px 24px; margin-bottom: 16px; box-shadow: 0 1px 2px rgb(20 22 28/.05);
  }
  h1 { font-size: 22px; font-weight: 650; letter-spacing:-.01em; margin: 0 0 6px; }
  h2 { font-size: 15px; font-weight: 600; margin: 0 0 14px; border-bottom: 1px solid var(--border); padding-bottom: 10px; }
  h3 { font-size: 14px; font-weight: 600; margin: 18px 0 6px; }
  .muted { color: var(--ink-3); font-size: 12.5px; }
  p { margin: 8px 0; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { padding: 9px 10px; text-align: right; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { font-weight: 500; color: var(--ink-3); font-size: 11.5px; }
  tr:last-child td { border-bottom: 0; }
  .score-big { font-size: 34px; font-weight: 650; letter-spacing:-.02em; line-height: 1; }
  .band { display:inline-block; font-size:12.5px; color:var(--ink-2); background:var(--sunken);
          border-radius:7px; padding:4px 11px; vertical-align: 6px; }
  .badge {
    display: inline-flex; align-items:center; gap:5px; padding: 3px 9px; border-radius: 6px;
    font-size: 12px; font-weight: 500;
  }
  .badge::before { content:""; width:6px; height:6px; border-radius:50%; background:currentColor; }
  .badge-ok { background: var(--ok-soft); color: var(--ok-ink); }
  .badge-warn { background: var(--warn-soft); color: var(--warn-ink); }
  .badge-fail { background: var(--bad-soft); color: var(--bad-ink); }
  .quote {
    background: var(--sunken); border-inline-start: 3px solid var(--border-2); border-radius: 0 8px 8px 0;
    padding: 9px 13px; margin: 6px 0; font-size: 12.5px;
  }
  .quote .ts { color: var(--ink-3); font-size: 11px; font-family: var(--mono); }
  .bar-row { display: grid; grid-template-columns: 1fr minmax(90px,150px) 44px; align-items: center; gap: 14px; margin: 4px 0; }
  .bar-label { font-size: 13px; color: var(--ink-2); }
  .bar-track { background: var(--bar-soft); border-radius: 100px; height: 6px; position: relative; }
  .bar-fill { position:absolute; inset-block:0; inset-inline-start:0; background: var(--bar); border-radius: 100px; }
  .bar-fill.warn { background: var(--warn); }
  .bar-marker { position: absolute; top: -3px; bottom: -3px; width: 1.5px; background: var(--ink-3); }
  .bar-value { font-size: 13px; font-weight: 600; text-align: end; font-variant-numeric: tabular-nums; }
  .rec { background: var(--sunken); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; margin-top: 8px; font-size: 13px; }
  .gt { font-size: 10.5px; color: var(--warn-ink); background: var(--warn-soft); border-radius: 5px; padding: 1px 7px; font-weight: 500; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  footer { margin-top: 20px; font-size: 11.5px; color: var(--ink-3); }
  code, .mono { font-family: var(--mono); direction: ltr; unicode-bidi: isolate; font-size: 12px; }
  mark { background: var(--warn-soft); color: inherit; padding: 0 2px; border-radius: 2px; box-shadow: 0 0 0 1px var(--warn); }
  .num { font-variant-numeric: tabular-nums; unicode-bidi: isolate; }
</style>
</head>
<body>
<div class="container">
{% block content %}{% endblock %}
<footer>{% block footer %}{% endblock %}</footer>
</div>
</body>
</html>
