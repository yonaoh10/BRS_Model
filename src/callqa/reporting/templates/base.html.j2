<!DOCTYPE html>
<html dir="rtl" lang="he">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}דוח{% endblock %}</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: "Segoe UI", "Arial Hebrew", Arial, sans-serif;
    margin: 0; padding: 24px; background: #f5f6f8; color: #1f2430;
    line-height: 1.55;
  }
  .container { max-width: 960px; margin: 0 auto; }
  .card {
    background: #fff; border: 1px solid #e3e6eb; border-radius: 10px;
    padding: 20px 24px; margin-bottom: 20px;
  }
  h1 { font-size: 1.5rem; margin: 0 0 4px; }
  h2 { font-size: 1.15rem; margin: 0 0 12px; border-bottom: 2px solid #eef0f3; padding-bottom: 8px; }
  h3 { font-size: 1rem; margin: 16px 0 6px; }
  .muted { color: #6b7280; font-size: 0.85rem; }
  table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  th, td { padding: 8px 10px; text-align: right; border-bottom: 1px solid #eef0f3; vertical-align: top; }
  th { background: #f8f9fb; font-weight: 600; }
  .score-big { font-size: 2.6rem; font-weight: 700; }
  .badge {
    display: inline-block; padding: 2px 12px; border-radius: 999px;
    font-size: 0.8rem; font-weight: 600; color: #fff;
  }
  .badge-ok { background: #1a7f37; }
  .badge-warn { background: #9a6700; }
  .badge-fail { background: #c0392b; }
  .quote {
    background: #f8f9fb; border-right: 3px solid #b9c2d0; border-radius: 6px;
    padding: 8px 12px; margin: 6px 0; font-size: 0.9rem;
  }
  .quote .ts { color: #6b7280; font-size: 0.8rem; }
  .bar-row { display: flex; align-items: center; gap: 10px; margin: 6px 0; }
  .bar-label { width: 160px; font-size: 0.88rem; }
  .bar-track { flex: 1; background: #eef0f3; border-radius: 6px; height: 16px; position: relative; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 6px; }
  .bar-marker { position: absolute; top: -2px; bottom: -2px; width: 2px; background: #1f2430; }
  .bar-value { width: 70px; font-size: 0.85rem; }
  .rec {
    background: #f0f7f1; border: 1px solid #cfe6d4; border-radius: 8px;
    padding: 12px 16px; margin-top: 8px;
  }
  a { color: #1c56b0; text-decoration: none; }
  a:hover { text-decoration: underline; }
  footer { margin-top: 24px; font-size: 0.78rem; color: #8a919c; }
  code { direction: ltr; unicode-bidi: bidi-override; font-size: 0.78rem; }
</style>
</head>
<body>
<div class="container">
{% block content %}{% endblock %}
<footer>{% block footer %}{% endblock %}</footer>
</div>
</body>
</html>
