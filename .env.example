# ---------------------------------------------------------------------------
#  Call-QA - secrets and per-machine settings
#
#  Copy this file to `.env` (same directory) and fill in what you need.
#  `.env` is ignored by git and is loaded automatically by:
#      python -m callqa ...           python cloud/runpod_cli.py ...
#      python dashboard/server.py     docker compose ...
#  A variable already set in your shell always wins over this file.
#
#  העתיקו את הקובץ הזה ל-`.env` באותה תיקייה ומלאו את מה שצריך.
#  הקובץ `.env` לא נכנס ל-git ונטען אוטומטית על ידי כל הפקודות למעלה.
#  משתנה שכבר מוגדר במעטפת תמיד גובר על מה שכתוב כאן.
# ---------------------------------------------------------------------------

# --- RunPod (dev-phase cloud GPU, see cloud/README.md) ----------------------
# Create at https://console.runpod.io/user/settings  ->  API Keys
# צרו מפתח בכתובת למעלה והדביקו אותו כאן, בלי מירכאות:
RUNPOD_API_KEY=

# --- Hugging Face (needed ONCE, to download the models) ---------------------
# Accept the model conditions first:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
# Then create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Endpoints of the running GPU box -------------------------------------
# `python cloud/runpod_cli.py up` fills these in for you. Leave them empty.
# `python cloud/runpod_cli.py up` ממלא את אלה לבד. השאירו ריק.
CALLQA_ASR__BASE_URL=
CALLQA_ASR__API_KEY=
CALLQA_JUDGE__BASE_URL=
CALLQA_JUDGE__API_KEY=

# --- Dashboard ---------------------------------------------------------------
# Optional. If set, the dashboard uses this as its session token instead of a
# random one, so the URL is stable: http://127.0.0.1:8765/?t=<this value>
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
CALLQA_DASHBOARD_TOKEN=
