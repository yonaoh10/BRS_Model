# ---------------------------------------------------------------------------
#  Call-QA - per-machine settings and secrets
#
#  Copy this file to `.env` (same directory) and fill in only what you need.
#  `.env` is ignored by git and is loaded automatically by `python -m callqa`,
#  `dashboard/server.py`, `scripts/download_models.py` and
#  `scripts/start_llama_server.py`. A variable already set in your shell
#  always wins over this file. Save it as UTF-8 (Notepad's default).
#
#  NOTHING here is required to run the pipeline in mock mode.
#
#  העתיקו את הקובץ הזה ל-`.env` באותה תיקייה ומלאו רק את מה שצריך.
#  הקובץ `.env` לא נכנס ל-git ונטען אוטומטית. משתנה שכבר מוגדר במעטפת גובר.
#  שום דבר כאן אינו נדרש כדי להריץ את המערכת במצב mock.
# ---------------------------------------------------------------------------

# --- Hugging Face: needed ONCE, to download the models ----------------------
# Only scripts/download_models.py reads this. The pipeline itself never
# downloads anything and never contacts Hugging Face at runtime.
#
# The diarization model is gated: accept its conditions with your HF account at
#   https://huggingface.co/pyannote/speaker-diarization-community-1
# then create a READ token at https://huggingface.co/settings/tokens
#
# נדרש רק להורדת המודלים, פעם אחת. הצינור עצמו לעולם לא מוריד דבר.
HF_TOKEN=

# --- Judge endpoint ---------------------------------------------------------
# The judge is an OpenAI-compatible /v1 client. Point it at whatever serves the
# model on this network (vLLM, TGI, llama.cpp server, an internal gateway).
# Defaults live in config/config.yaml; set these to override per machine.
#
# CALLQA_JUDGE__BASE_URL=http://127.0.0.1:8000/v1
# CALLQA_JUDGE__API_KEY=

# --- Dashboard --------------------------------------------------------------
# Optional, and ignored on Windows (on a shared host a token that never changes
# can be collected by another user). If set, the local dashboard uses this as
# its session token instead of a random one, so the URL stays stable across
# restarts:
#   http://127.0.0.1:8765/?t=<this value>
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
CALLQA_DASHBOARD_TOKEN=

# --- Bank network (only for the one-time downloads) --------------------------
# If downloads fail with "certificate verify failed" or a proxy error, IT can
# give you the proxy address and the bank's root certificate (.pem):
# HTTPS_PROXY=http://<proxy>:<port>
# REQUESTS_CA_BUNDLE=C:\Users\<name>\bank-root.pem
#
# --- Machine without internet (models copied from another machine) ----------
# HF_HOME=C:\Users\<name>\hf-cache
